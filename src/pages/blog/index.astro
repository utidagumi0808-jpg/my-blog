---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`記事一覧 | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.page-header {
				background: var(--accent-light);
				border-bottom: 3px solid var(--accent);
				padding: 1.4em 0;
				margin-bottom: 2em;
			}
			.page-header-inner {
				max-width: 1000px;
				margin: 0 auto;
				padding: 0 1em;
			}
			.page-title {
				font-family: 'Noto Serif JP', serif;
				font-size: 1.3em;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 0 0 0.2em;
			}
			.page-count {
				font-size: 0.82em;
				color: rgb(var(--gray));
			}
			main {
				max-width: 1000px;
				margin: 0 auto;
				padding: 0 1em 4em;
			}
			.post-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.4em;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-card {
				background: #ffffff;
				border: 1px solid var(--border);
				border-radius: 10px;
				overflow: hidden;
				box-shadow: var(--box-shadow);
				transition: box-shadow 0.2s, transform 0.2s;
				display: flex;
				flex-direction: column;
			}
			.post-card:hover {
				box-shadow: 0 6px 24px rgba(0,0,0,0.13);
				transform: translateY(-3px);
			}
			.post-card a {
				display: flex;
				flex-direction: column;
				text-decoration: none;
				color: inherit;
				height: 100%;
			}
			.post-thumbnail {
				aspect-ratio: 16 / 9;
				overflow: hidden;
				background: var(--accent-light);
			}
			.post-thumbnail img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
				transition: transform 0.35s;
			}
			.post-card:hover .post-thumbnail img {
				transform: scale(1.06);
			}
			.post-thumbnail-placeholder {
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 2.5em;
				color: var(--accent);
				background: var(--accent-light);
			}
			.post-body {
				padding: 1em 1.1em 1.2em;
				display: flex;
				flex-direction: column;
				gap: 0.4em;
				flex: 1;
			}
			.post-date {
				font-size: 0.75em;
				color: rgb(var(--gray));
				margin: 0;
			}
			.post-title {
				font-family: 'Noto Serif JP', serif;
				font-size: 0.95em;
				font-weight: 700;
				color: rgb(var(--black));
				line-height: 1.55;
				margin: 0;
			}
			.post-card:hover .post-title {
				color: var(--accent);
			}
			.post-desc {
				font-size: 0.8em;
				color: rgb(var(--gray));
				line-height: 1.65;
				margin: 0;
				flex: 1;
				display: -webkit-box;
				-webkit-line-clamp: 3;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.read-more {
				display: inline-block;
				margin-top: 0.7em;
				font-size: 0.78em;
				color: var(--accent);
				font-weight: 700;
			}
			@media (max-width: 760px) {
				.post-grid { grid-template-columns: repeat(2, 1fr); }
			}
			@media (max-width: 480px) {
				.post-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<div class="page-header">
			<div class="page-header-inner">
				<h1 class="page-title">記事一覧</h1>
				<p class="page-count">全 {posts.length} 記事</p>
			</div>
		</div>
		<main>
			<ul class="post-grid">
				{posts.map((post) => (
					<li class="post-card">
						<a href={`/blog/${post.id}/`}>
							<div class="post-thumbnail">
								{post.data.heroImage
									? <img src={post.data.heroImage} alt={post.data.title} />
									: <div class="post-thumbnail-placeholder">🧬</div>
								}
							</div>
							<div class="post-body">
								<p class="post-date"><FormattedDate date={post.data.pubDate} /></p>
								<h2 class="post-title">{post.data.title}</h2>
								{post.data.description && (
									<p class="post-desc">{post.data.description}</p>
								)}
								<span class="read-more">続きを読む →</span>
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
