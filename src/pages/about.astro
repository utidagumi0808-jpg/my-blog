---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`このブログについて | ${SITE_TITLE}`} description="ヒトのトリセツの管理人プロフィールとブログについての説明ページです。" />
		<style>
			.page-title {
				font-family: 'Noto Serif JP', serif;
				font-size: 1.4em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 1.5em;
				padding-bottom: 0.6em;
				border-bottom: 3px solid var(--accent);
			}
			.profile-card {
				background: #ffffff;
				border: 1px solid var(--border);
				border-radius: 8px;
				padding: 2em;
				box-shadow: var(--box-shadow);
				margin-bottom: 2em;
			}
			.profile-label {
				display: inline-block;
				background: var(--accent);
				color: white;
				font-size: 0.75em;
				letter-spacing: 0.1em;
				padding: 0.3em 0.8em;
				border-radius: 3px;
				margin-bottom: 1em;
			}
			.profile-text {
				font-size: 1em;
				line-height: 2;
				color: rgb(var(--gray-dark));
				margin: 0;
			}
			.about-section {
				background: #ffffff;
				border: 1px solid var(--border);
				border-radius: 8px;
				padding: 2em;
				box-shadow: var(--box-shadow);
			}
			.about-section h2 {
				font-family: 'Noto Serif JP', serif;
				font-size: 1.1em;
				font-weight: 700;
				padding: 0.4em 0.8em;
				border-left: 4px solid var(--accent);
				background: var(--accent-light);
				margin-bottom: 1em;
				margin-top: 0;
			}
			.about-section p {
				font-size: 0.95em;
				line-height: 1.9;
				color: rgb(var(--gray-dark));
				margin-bottom: 1em;
			}
			.about-section p:last-child {
				margin-bottom: 0;
			}
			.theme-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
			}
			.theme-list li {
				background: var(--accent-light);
				border: 1px solid var(--accent);
				color: var(--accent-dark);
				padding: 0.3em 0.9em;
				border-radius: 20px;
				font-size: 0.85em;
				margin-bottom: 0;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">このブログについて</h1>

			<div class="profile-card">
				<span class="profile-label">管理人プロフィール</span>
				<p class="profile-text">
					専門家ではありません。ただ、人間という生き物への好奇心がある一般人です。<br>
					生理人類学、関連書籍などの情報を読み漁り、面白いと思ったことをこのブログにまとめています。
				</p>
			</div>

			<div class="about-section">
				<h2>ブログのテーマ</h2>
				<p>
					「ヒトのトリセツ」は、生理人類学の視点から人体の仕組みをわかりやすく解説するブログです。
					睡眠・食・ストレス・体温調節・進化と体の設計など、あなたの体が「なぜそう動くのか」を
					学術的な正確さを大切にしながらお届けします。
				</p>
				<ul class="theme-list">
					<li>睡眠・体内時計</li>
					<li>食と代謝</li>
					<li>ストレスと体</li>
					<li>体温調節</li>
					<li>進化と人体の設計</li>
					<li>生理人類学</li>
				</ul>
			</div>
		</main>
		<Footer />
	</body>
</html>
