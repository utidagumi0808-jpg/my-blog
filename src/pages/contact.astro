---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={`お問い合わせ | ${SITE_TITLE}`} description="ヒトのトリセツへのお問い合わせページです。記事に関するご質問・ご感想などお気軽にどうぞ。" />
		<style>
			main {
				max-width: 720px;
				margin: 0 auto;
				padding: 3em 1.5em 5em;
			}
			.page-title {
				font-family: 'Noto Serif JP', serif;
				font-size: 1.4em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 1.8em;
				padding-bottom: 0.6em;
				border-bottom: 3px solid var(--accent);
			}
			.form-card {
				background: #ffffff;
				border: 1px solid var(--border);
				border-radius: 10px;
				padding: 2em 2.2em;
				box-shadow: var(--box-shadow);
				margin-bottom: 1.6em;
			}
			.form-card p {
				font-size: 0.93em;
				line-height: 2;
				color: rgb(var(--gray-dark));
				margin-bottom: 1.6em;
			}
			.form-group {
				margin-bottom: 1.4em;
			}
			.form-group label {
				display: block;
				font-size: 0.88em;
				font-weight: 700;
				color: rgb(var(--black));
				margin-bottom: 0.4em;
			}
			.form-group label .required {
				color: #c0392b;
				margin-left: 4px;
				font-size: 0.85em;
			}
			.form-group input,
			.form-group textarea {
				width: 100%;
				padding: 0.7em 0.9em;
				border: 1.5px solid var(--border);
				border-radius: 6px;
				font-size: 0.93em;
				font-family: inherit;
				color: rgb(var(--black));
				background: #fafafa;
				box-sizing: border-box;
				transition: border-color 0.2s;
				outline: none;
			}
			.form-group input:focus,
			.form-group textarea:focus {
				border-color: var(--accent);
				background: #fff;
			}
			.form-group textarea {
				min-height: 160px;
				resize: vertical;
			}
			.submit-btn {
				display: inline-block;
				background: var(--accent);
				color: #ffffff;
				padding: 0.75em 2.5em;
				border: none;
				border-radius: 6px;
				font-size: 0.95em;
				font-weight: 700;
				font-family: inherit;
				cursor: pointer;
				transition: opacity 0.2s;
			}
			.submit-btn:hover { opacity: 0.85; }
			.submit-btn:disabled { opacity: 0.5; cursor: not-allowed; }
			.result-message {
				display: none;
				margin-top: 1.2em;
				padding: 1em 1.2em;
				border-radius: 6px;
				font-size: 0.9em;
				line-height: 1.7;
			}
			.result-message.success {
				background: #e8f5e9;
				border: 1px solid #a5d6a7;
				color: #2e7d32;
			}
			.result-message.error {
				background: #fce4ec;
				border: 1px solid #f48fb1;
				color: #c62828;
			}
			.note-box {
				background: #f8f5f0;
				border: 1px solid var(--border);
				border-left: 4px solid #888;
				border-radius: 4px;
				padding: 1em 1.3em;
				font-size: 0.83em;
				line-height: 1.85;
				color: rgb(var(--gray));
				margin-top: 1.6em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1 class="page-title">お問い合わせ</h1>

			<div class="form-card">
				<p>
					記事に関するご質問・ご感想・誤りのご指摘など、お気軽にお問い合わせください。<br>
					通常2〜5営業日以内にご返信いたします。
				</p>

				<form id="contact-form">
					<!-- Web3Forms access key（web3forms.comで取得したキーに差し替えてください） -->
					<input type="hidden" name="access_key" value="YOUR_WEB3FORMS_ACCESS_KEY" />
					<input type="hidden" name="subject" value="【ヒトのトリセツ】お問い合わせ" />
					<input type="hidden" name="from_name" value="ヒトのトリセツ お問い合わせフォーム" />

					<div class="form-group">
						<label for="name">お名前<span class="required">*</span></label>
						<input type="text" id="name" name="name" placeholder="例：山田 太郎" required />
					</div>

					<div class="form-group">
						<label for="email">メールアドレス<span class="required">*</span></label>
						<input type="email" id="email" name="email" placeholder="例：example@email.com" required />
					</div>

					<div class="form-group">
						<label for="message">お問い合わせ内容<span class="required">*</span></label>
						<textarea id="message" name="message" placeholder="お問い合わせ内容をご記入ください" required></textarea>
					</div>

					<button type="submit" class="submit-btn" id="submit-btn">送信する</button>

					<div class="result-message" id="result-message"></div>
				</form>

				<div class="note-box">
					いただいた情報は、ご返信の目的にのみ使用いたします。第三者への提供は一切行いません。
				</div>
			</div>
		</main>
		<Footer />

		<script>
			const form = document.getElementById('contact-form') as HTMLFormElement;
			const btn = document.getElementById('submit-btn') as HTMLButtonElement;
			const result = document.getElementById('result-message') as HTMLDivElement;

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				btn.disabled = true;
				btn.textContent = '送信中...';
				result.style.display = 'none';

				const formData = new FormData(form);
				const res = await fetch('https://api.web3forms.com/submit', {
					method: 'POST',
					body: formData,
				});
				const data = await res.json();

				if (data.success) {
					result.className = 'result-message success';
					result.textContent = 'お問い合わせを受け付けました。ありがとうございます！通常2〜5営業日以内にご返信いたします。';
					form.reset();
					btn.textContent = '送信完了';
				} else {
					result.className = 'result-message error';
					result.textContent = '送信に失敗しました。しばらく時間をおいてから再度お試しください。';
					btn.disabled = false;
					btn.textContent = '送信する';
				}
				result.style.display = 'block';
			});
		</script>
	</body>
</html>
