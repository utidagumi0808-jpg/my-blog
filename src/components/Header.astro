---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="header-inner">
		<div class="logo">
			<a href="/">
				<span class="logo-main">{SITE_TITLE}</span>
				<span class="logo-sub">生理人類学で読み解く、あなたの体の設計図</span>
			</a>
		</div>
		<button class="nav-toggle" aria-label="メニューを開く" aria-expanded="false">
			<span></span>
			<span></span>
			<span></span>
		</button>
		<nav>
			<HeaderLink href="/">ホーム</HeaderLink>
			<HeaderLink href="/blog">記事一覧</HeaderLink>
			<HeaderLink href="/about">このブログについて</HeaderLink>
			<HeaderLink href="/contact">お問い合わせ</HeaderLink>
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector('.nav-toggle') as HTMLButtonElement;
	const nav = document.querySelector('header nav') as HTMLElement;
	if (toggle && nav) {
		toggle.addEventListener('click', () => {
			const isOpen = nav.classList.toggle('is-open');
			toggle.classList.toggle('is-open');
			toggle.setAttribute('aria-expanded', String(isOpen));
			toggle.setAttribute('aria-label', isOpen ? 'メニューを閉じる' : 'メニューを開く');
		});
		// ナビリンクをクリックしたら閉じる
		nav.querySelectorAll('a').forEach(link => {
			link.addEventListener('click', () => {
				nav.classList.remove('is-open');
				toggle.classList.remove('is-open');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.setAttribute('aria-label', 'メニューを開く');
			});
		});
	}
</script>

<style>
	header {
		background: #1a3a2a;
		padding: 0 1.5em;
		box-shadow: 0 2px 8px rgba(0,0,0,0.2);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.header-inner {
		max-width: 1000px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.8em 0;
		gap: 1em;
	}
	.logo a {
		text-decoration: none;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.logo-main {
		font-family: 'Noto Serif JP', serif;
		font-size: 1.3em;
		font-weight: 700;
		color: #ffffff;
		letter-spacing: 0.05em;
	}
	.logo-sub {
		font-size: 0.65em;
		color: rgba(255,255,255,0.6);
		letter-spacing: 0.05em;
	}
	nav {
		display: flex;
		gap: 0.2em;
	}
	nav :global(a) {
		color: rgba(255,255,255,0.85);
		padding: 0.4em 0.8em;
		border-radius: 4px;
		font-size: 0.88em;
		text-decoration: none;
		transition: background 0.2s, color 0.2s;
		white-space: nowrap;
	}
	nav :global(a:hover),
	nav :global(a.active) {
		background: rgba(255,255,255,0.15);
		color: #ffffff;
		text-decoration: none;
	}

	/* ハンバーガーボタン：デスクトップでは非表示 */
	.nav-toggle {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		background: none;
		border: none;
		cursor: pointer;
		padding: 6px 4px;
		flex-shrink: 0;
	}
	.nav-toggle span {
		display: block;
		width: 24px;
		height: 2px;
		background: white;
		border-radius: 2px;
		transition: transform 0.25s, opacity 0.25s;
	}
	.nav-toggle.is-open span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.nav-toggle.is-open span:nth-child(2) {
		opacity: 0;
	}
	.nav-toggle.is-open span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* モバイル */
	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}
		.header-inner {
			flex-direction: row;
			align-items: center;
			padding: 0.65em 0;
			gap: 0.5em;
		}
		.logo-sub { display: none; }
		.logo-main { font-size: 1.1em; }

		.nav-toggle { display: flex; }

		nav {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			background: #1a3a2a;
			flex-direction: column;
			padding: 0.4em 1em 0.8em;
			box-shadow: 0 6px 16px rgba(0,0,0,0.35);
			z-index: 99;
			gap: 0;
		}
		nav.is-open {
			display: flex;
		}
		nav :global(a) {
			padding: 0.75em 0.5em;
			font-size: 0.95em;
			border-bottom: 1px solid rgba(255,255,255,0.1);
			border-radius: 0;
			width: 100%;
		}
		nav :global(a:last-child) {
			border-bottom: none;
		}
	}
</style>
