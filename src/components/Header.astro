---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<div class="header-inner">
		<div class="logo">
			<a href="/">
				<span class="logo-main">{SITE_TITLE}</span>
				<span class="logo-sub">生理人類学で読み解く、あなたの体の設計図</span>
			</a>
		</div>
		<nav>
			<HeaderLink href="/">ホーム</HeaderLink>
			<HeaderLink href="/blog">記事一覧</HeaderLink>
			<HeaderLink href="/about">このブログについて</HeaderLink>
			<HeaderLink href="/contact">お問い合わせ</HeaderLink>
		</nav>
	</div>
</header>

<style>
	header {
		background: #1a3a2a;
		padding: 0 1.5em;
		box-shadow: 0 2px 8px rgba(0,0,0,0.2);
		position: sticky;
		top: 0;
		z-index: 100;
	}
	.header-inner {
		max-width: 1000px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.8em 0;
		gap: 1em;
	}
	.logo a {
		text-decoration: none;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.logo-main {
		font-family: 'Noto Serif JP', serif;
		font-size: 1.3em;
		font-weight: 700;
		color: #ffffff;
		letter-spacing: 0.05em;
	}
	.logo-sub {
		font-size: 0.65em;
		color: rgba(255,255,255,0.6);
		letter-spacing: 0.05em;
	}
	nav {
		display: flex;
		gap: 0.2em;
	}
	nav :global(a) {
		color: rgba(255,255,255,0.85);
		padding: 0.4em 0.8em;
		border-radius: 4px;
		font-size: 0.88em;
		text-decoration: none;
		transition: background 0.2s, color 0.2s;
	}
	nav :global(a:hover),
	nav :global(a.active) {
		background: rgba(255,255,255,0.15);
		color: #ffffff;
		text-decoration: none;
	}
	@media (max-width: 720px) {
		.header-inner {
			flex-direction: column;
			align-items: center;
			padding: 0.5em 0;
			gap: 0.3em;
		}
		.logo a {
			align-items: center;
		}
		.logo-sub { display: none; }
		.logo-main { font-size: 1.15em; }
		nav {
			width: 100%;
			flex-wrap: wrap;
			justify-content: center;
			gap: 0.15em;
		}
		nav :global(a) {
			padding: 0.3em 0.55em;
			font-size: 0.8em;
			white-space: nowrap;
		}
	}
</style>
