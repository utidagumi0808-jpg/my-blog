---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<div class="footer-brand">
			<span class="footer-title">ヒトのトリセツ</span>
			<p class="footer-desc">生理人類学の視点から、あなたの体の設計図を読み解くブログ</p>
		</div>
		<div class="footer-links">
			<a href="/">ホーム</a>
			<a href="/blog">記事一覧</a>
			<a href="/about">このブログについて</a>
			<a href="/contact">お問い合わせ</a>
			<a href="/privacy">プライバシーポリシー</a>
		</div>
		<div class="footer-copy">
			&copy; {today.getFullYear()} ヒトのトリセツ All rights reserved.
		</div>
	</div>
</footer>

<style>
	footer {
		background: #1a3a2a;
		color: rgba(255,255,255,0.75);
		margin-top: 4em;
	}
	.footer-inner {
		max-width: 1000px;
		margin: 0 auto;
		padding: 2.5em 1.5em;
		display: flex;
		flex-direction: column;
		gap: 1.2em;
		align-items: center;
		text-align: center;
	}
	.footer-title {
		font-family: 'Noto Serif JP', serif;
		font-size: 1.2em;
		font-weight: 700;
		color: #ffffff;
		letter-spacing: 0.05em;
	}
	.footer-desc {
		margin: 0.4em 0 0;
		font-size: 0.8em;
		color: rgba(255,255,255,0.5);
	}
	.footer-links {
		display: flex;
		gap: 1.5em;
	}
	.footer-links a {
		color: rgba(255,255,255,0.65);
		text-decoration: none;
		font-size: 0.85em;
		transition: color 0.2s;
	}
	.footer-links a:hover {
		color: #ffffff;
		text-decoration: none;
	}
	.footer-copy {
		font-size: 0.75em;
		color: rgba(255,255,255,0.4);
	}
</style>
