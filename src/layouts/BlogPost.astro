---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="ja">
	<head>
		<BaseHead title={`${title} | 人の取説`} description={description} />
		<style>
			.article-wrapper {
				max-width: 780px;
				margin: 0 auto;
				padding: 2em 1em;
			}
			.hero-image {
				border-radius: 8px;
				overflow: hidden;
				margin-bottom: 1.5em;
				box-shadow: var(--box-shadow);
			}
			.hero-image img {
				width: 100%;
				display: block;
				border-radius: 8px;
			}
			.article-meta {
				margin-bottom: 1.2em;
				display: flex;
				align-items: center;
				gap: 1em;
				flex-wrap: wrap;
			}
			.article-date {
				font-size: 0.85em;
				color: rgb(var(--gray));
				display: flex;
				align-items: center;
				gap: 0.3em;
			}
			.article-date::before {
				content: "📅";
				font-size: 0.9em;
			}
			.last-updated {
				font-size: 0.82em;
				color: rgb(var(--gray));
				font-style: italic;
			}
			.article-title {
				font-family: 'Noto Serif JP', serif;
				font-size: 1.7em;
				font-weight: 700;
				line-height: 1.4;
				color: rgb(var(--black));
				margin-bottom: 0.5em;
			}
			.article-desc {
				font-size: 0.95em;
				color: rgb(var(--gray));
				background: var(--accent-light);
				border-left: 4px solid var(--accent);
				padding: 0.8em 1em;
				border-radius: 0 6px 6px 0;
				margin-bottom: 1.5em;
				line-height: 1.7;
			}
			hr.divider {
				border: none;
				border-top: 1px solid var(--border);
				margin: 1.5em 0 2em;
			}
			.prose {
				color: rgb(var(--gray-dark));
			}
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				color: var(--accent);
				font-size: 0.88em;
				margin-top: 3em;
				padding: 0.5em 1em;
				border: 1px solid var(--accent);
				border-radius: 4px;
				transition: background 0.2s, color 0.2s;
			}
			.back-link:hover {
				background: var(--accent);
				color: white;
				text-decoration: none;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article class="article-wrapper">
				{heroImage && (
					<div class="hero-image">
						<Image width={780} height={390} src={heroImage} alt="" />
					</div>
				)}
				<div class="article-meta">
					<span class="article-date">
						<FormattedDate date={pubDate} />
					</span>
					{updatedDate && (
						<span class="last-updated">
							更新日: <FormattedDate date={updatedDate} />
						</span>
					)}
				</div>
				<h1 class="article-title">{title}</h1>
				{description && (
					<p class="article-desc">{description}</p>
				)}
				<hr class="divider" />
				<div class="prose">
					<slot />
				</div>
				<a href="/blog" class="back-link">← 記事一覧に戻る</a>
			</article>
		</main>
		<Footer />
	</body>
</html>
